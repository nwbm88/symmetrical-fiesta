{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClearWave",
  "version": "0.1.0",
  "identifier": "com.clearwave.audio",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ClearWave — Restore & Remaster",
        "width": 1320,
        "height": 860,
        "minWidth": 1040,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}

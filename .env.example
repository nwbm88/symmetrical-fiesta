# Copy to .env and fill in. Get credentials at https://develop.battle.net (free).
BLIZZARD_CLIENT_ID=your_client_id
BLIZZARD_CLIENT_SECRET=your_client_secret

# us | eu | kr | tw. Sets the API host, OAuth host, and namespace suffix.
REGION=us

# static-<region> for game data, profile-<region> for character data.
# These are derived from REGION automatically; override only if you know why.

# Postgres connection string. SQLite users: see docs/architecture.md.
DATABASE_URL=postgres://localhost:5432/wowtracker

PORT=3000
